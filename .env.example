# --- Anthropic (Claude Managed Agents) ---------------------------------------
# Auth: an `ant auth login` profile is picked up automatically by the SDK;
# alternatively export ANTHROPIC_API_KEY.
# Create these once from cma/*.yaml — see README step 2:
CMA_AGENT_ID=
CMA_ENVIRONMENT_ID=

# --- Channel ------------------------------------------------------------------
# Must match the --name passed to `copilotkit channels add`.
CHANNEL_NAME=cma-assistant
# PORT=4111
# Per-turn ceiling in ms (default 5 minutes):
# CMA_TURN_TIMEOUT_MS=300000

# --- CopilotKit Intelligence (hosted transport) -------------------------------
# Written into .env by the copilotkit CLI during project setup:
INTELLIGENCE_API_KEY=
# Only for non-default deployments; the hosted platform default works unset:
# COPILOTKIT_INTELLIGENCE_WS_URL=

# --- Slack (setup-time only) --------------------------------------------------
# During `channels add`, the CLI asks for these under names derived from your
# channel name. They are uploaded and stored server-side once the adapter
# attaches (diagnostic: setup_credentials_removable) — delete them after.
# INTELLIGENCE_CHANNEL_CMA_ASSISTANT_SLACK_BOT_TOKEN=
# INTELLIGENCE_CHANNEL_CMA_ASSISTANT_SLACK_SIGNING_SECRET=
